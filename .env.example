# Email delivery for the /contact quote form (src/app/api/quote/route.ts)
# Sign up at https://resend.com, verify a sending domain, then set:
RESEND_API_KEY=
# Inbox that receives quote requests (defaults to site.email in src/lib/site.ts)
CONTACT_TO_EMAIL=
# Must be a verified sender/domain in Resend (defaults to onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID. Leave blank to disable.
NEXT_PUBLIC_META_PIXEL_ID=
