# Email delivery for the /contact quote form (src/app/api/quote/route.ts)
# Sign up at https://resend.com, verify a sending domain, then set:
RESEND_API_KEY=
# Inbox that receives quote requests (defaults to site.email in src/lib/site.ts)
CONTACT_TO_EMAIL=
# Must be a verified sender/domain in Resend (defaults to onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Meta (Facebook) Pixel ID. Leave blank to disable.
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Live chat (optional). With none of these set the chat widget does not render and
# /api/quote works exactly as before. See "Live chat" in the README.
# ---------------------------------------------------------------------------
# Supabase project URL and the new publishable key (sb_publishable_...). Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). SERVER ONLY. Never expose it or commit it.
SUPABASE_SECRET_KEY=
# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@australiawidewreckers.com.au
# Shared secret Postgres sends to /api/chat/events and /api/chat/cron/* (use a long random string).
CHAT_WEBHOOK_SECRET=
# Public site URL used in invite/reset emails (defaults to src/lib/site.ts url)
NEXT_PUBLIC_SITE_URL=
# Optional Cloudflare Turnstile site key; the secret key goes into Supabase Auth, Captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
